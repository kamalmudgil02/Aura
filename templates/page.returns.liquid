<div class="announcement-bar">
        Free shipping on all US orders over $150 · <strong>New drops every Friday</strong>
    </div>
    <header class="site-header">
        <div class="container header-inner">
            <a href="/" class="logo">Aura.</a>
            <nav class="nav-links">
                <a href="index.html#men" class="nav-link">Men</a>
                <a href="index.html#women" class="nav-link">Women</a>
                <a href="index.html#footwear" class="nav-link">Footwear</a>
                <a href="index.html#accessories" class="nav-link">Accessories</a>
                <a href="/pages/stories" class="nav-link">Stories</a>
            </nav>
            <div class="header-actions">
                <button class="icon-btn cart-icon" id="cart-toggle" aria-label="Cart"><svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg><span class="cart-count" id="header-cart-count">0</span></button>
                <button class="icon-btn menu-toggle" aria-label="Menu"><svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path></svg></button>
            </div>
        </div>
    </header>

    <section class="returns-hero">
        <h1 class="text-3xl mb-2">Returns & Exchange</h1>
        <p class="text-muted">We want you to love your purchase. If not, we've got you covered.</p>
    </section>

    <div class="returns-container">
        <!-- Step indicator -->
        <div class="step-indicator">
            <div class="step-dot active" id="dot-1">1</div>
            <div class="step-dot" id="dot-2">2</div>
            <div class="step-dot" id="dot-3">3</div>
            <div class="step-dot" id="dot-4">4</div>
        </div>

        <!-- Step 1: Find Order -->
        <div class="return-step active" id="step-1">
            <h2 class="text-xl mb-2">Find Your Order</h2>
            <p class="text-muted text-sm mb-4">Enter your Order ID and email to begin the return or exchange process.</p>
            <div class="form-group">
                <label class="form-label">Order ID</label>
                <input type="text" id="return-order-id" class="form-control" placeholder="e.g. ORD-45678" required>
            </div>
            <div class="form-group">
                <label class="form-label">Email Address</label>
                <input type="email" id="return-email" class="form-control" placeholder="you@example.com" required>
            </div>
            <p class="text-xs text-muted mb-4" id="order-error" style="display:none; color:#d93025;">Order not found. Please check your Order ID and email.</p>
            <button class="btn btn-primary w-full btn-large" id="btn-find-order">Find My Order</button>
            <p class="text-xs text-muted text-center mt-4">Don't have an Order ID? Check your confirmation email or <a href="#" class="link" onclick="alert('Email support@aura.com for assistance.'); return false;">contact support</a>.</p>
        </div>

        <!-- Step 2: Select Return or Exchange + Items -->
        <div class="return-step" id="step-2">
            <h2 class="text-xl mb-2">What Would You Like To Do?</h2>
            <div class="return-type-tabs mb-4">
                <div class="return-type-tab active" data-type="return" id="tab-return">🔄 Return</div>
                <div class="return-type-tab" data-type="exchange" id="tab-exchange">🔃 Exchange</div>
            </div>
            <h3 class="text-sm fw-semibold mb-3 text-uppercase text-muted">Order Items</h3>
            <div id="order-items-list"></div>
            <div class="flex justify-between mt-4">
                <button class="btn btn-outline" id="btn-back-1">← Back</button>
                <button class="btn btn-primary" id="btn-next-3">Continue →</button>
            </div>
        </div>

        <!-- Step 3: Select Reason -->
        <div class="return-step" id="step-3">
            <h2 class="text-xl mb-2">Why Are You <span id="reason-action-word">Returning</span>?</h2>
            <p class="text-muted text-sm mb-4">Select a reason below so we can improve our products and service.</p>

            <label class="reason-option"><input type="radio" name="return-reason" value="wrong_size"> Wrong size or fit</label>
            <label class="reason-option"><input type="radio" name="return-reason" value="not_as_described"> Item not as described</label>
            <label class="reason-option"><input type="radio" name="return-reason" value="damaged"> Item arrived damaged or defective</label>
            <label class="reason-option"><input type="radio" name="return-reason" value="changed_mind"> Changed my mind</label>
            <label class="reason-option"><input type="radio" name="return-reason" value="wrong_item"> Received wrong item</label>
            <label class="reason-option"><input type="radio" name="return-reason" value="quality"> Quality not as expected</label>
            <label class="reason-option"><input type="radio" name="return-reason" value="other"> Other (please specify below)</label>

            <div class="form-group mt-3" id="other-reason-group" style="display:none;">
                <label class="form-label">Please explain</label>
                <textarea id="other-reason-text" class="form-control" rows="3" placeholder="Tell us what happened..."></textarea>
            </div>

            <div class="form-group mt-3">
                <label class="form-label">Additional comments <span class="text-muted">(optional)</span></label>
                <textarea id="return-comments" class="form-control" rows="2" placeholder="Anything else we should know?"></textarea>
            </div>

            <div class="flex justify-between mt-4">
                <button class="btn btn-outline" id="btn-back-2">← Back</button>
                <button class="btn btn-primary" id="btn-submit-return">Submit Request</button>
            </div>
        </div>

        <!-- Step 4: Confirmation -->
        <div class="return-step" id="step-4">
            <div class="success-card">
                <div style="font-size:3rem; margin-bottom:var(--space-2);">✓</div>
                <h2 class="text-2xl mb-2">Request Submitted!</h2>
                <p class="text-muted mb-4" id="confirmation-text">Your return request has been submitted.</p>
                <p class="text-sm mb-2"><strong>Request ID:</strong> <span id="request-id">—</span></p>
                <p class="text-sm text-muted mb-6">You'll receive an email with a prepaid shipping label and instructions within 24 hours.</p>
                <div class="flex gap-3 justify-center">
                    <a href="/" class="btn btn-primary">Continue Shopping</a>
                    <button class="btn btn-outline" id="btn-new-request">New Request</button>
                </div>
            </div>
        </div>
    </div>

    

    <!-- Cart Drawer -->
    
    <div class="cart-drawer" id="cart-drawer">
        <div class="cart-header flex justify-between align-center p-4 border-bottom"><h2 class="text-xl fw-bold">Your Cart</h2><button class="icon-btn" id="close-cart" style="font-size:1.5rem;">&times;</button></div>
        <div class="cart-items p-4 flex-col gap-4" id="cart-items-container" style="overflow-y:auto; flex-grow:1;"></div>
        <div class="cart-footer p-4 border-top"><div class="flex justify-between mb-4 fw-bold"><span>Subtotal</span><span id="cart-subtotal">$0.00</span></div><button class="btn btn-primary w-full btn-large" id="btn-mock-checkout">Checkout</button><p id="checkout-msg" class="text-xs text-center mt-2" style="display:none;"></p></div>
    </div>

    
    
    <script>
    document.addEventListener('DOMContentLoaded', () => {
        const steps = [1,2,3,4];
        const dots = steps.map(s => document.getElementById('dot-'+s));
        const panels = steps.map(s => document.getElementById('step-'+s));
        let currentStep = 1;
        let returnType = 'return';
        let foundOrder = null;

        function goTo(step) {
            currentStep = step;
            panels.forEach(p => p.classList.remove('active'));
            dots.forEach(d => { d.classList.remove('active','done'); });
            panels[step-1].classList.add('active');
            for (let i = 0; i < steps.length; i++) {
                if (i < step-1) dots[i].classList.add('done');
                else if (i === step-1) dots[i].classList.add('active');
            }
        }

        // Return/Exchange type tabs
        document.querySelectorAll('.return-type-tab').forEach(tab => {
            tab.addEventListener('click', function() {
                document.querySelectorAll('.return-type-tab').forEach(t => t.classList.remove('active'));
                this.classList.add('active');
                returnType = this.dataset.type;
                document.getElementById('reason-action-word').textContent = returnType === 'return' ? 'Returning' : 'Exchanging';
            });
        });

        // Step 1: Find order
        document.getElementById('btn-find-order').addEventListener('click', () => {
            const orderId = document.getElementById('return-order-id').value.trim();
            const email = document.getElementById('return-email').value.trim();
            if (!orderId || !email) { alert('Please fill in both fields.'); return; }

            const orders = window.Store ? window.Store.getOrders() : [];
            foundOrder = orders.find(o => o.id.toLowerCase() === orderId.toLowerCase() && o.customerEmail.toLowerCase() === email.toLowerCase());

            if (!foundOrder) { document.getElementById('order-error').style.display = 'block'; return; }
            document.getElementById('order-error').style.display = 'none';

            // Render order items (we don't store line items, so show summary)
            const itemsList = document.getElementById('order-items-list');
            itemsList.innerHTML = `
                <div class="order-card">
                    <div style="width:60px;height:60px;background:var(--color-bg-alt);border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;font-size:1.5rem;">📦</div>
                    <div style="flex:1;">
                        <p class="fw-semibold text-sm">${foundOrder.id}</p>
                        <p class="text-xs text-muted">${foundOrder.itemCount} item(s) · $${foundOrder.total.toFixed(2)}</p>
                        <p class="text-xs text-muted">Placed on ${new Date(foundOrder.date).toLocaleDateString()}</p>
                    </div>
                    <span class="status-badge paid">${foundOrder.status}</span>
                </div>`;
            goTo(2);
        });

        // Step 2 navigation
        document.getElementById('btn-back-1').addEventListener('click', () => goTo(1));
        document.getElementById('btn-next-3').addEventListener('click', () => goTo(3));

        // Step 3: Reason selection
        document.querySelectorAll('input[name="return-reason"]').forEach(radio => {
            radio.addEventListener('change', function() {
                document.getElementById('other-reason-group').style.display = this.value === 'other' ? 'block' : 'none';
            });
        });

        document.getElementById('btn-back-2').addEventListener('click', () => goTo(2));
        document.getElementById('btn-submit-return').addEventListener('click', () => {
            const selected = document.querySelector('input[name="return-reason"]:checked');
            if (!selected) { alert('Please select a reason.'); return; }
            if (selected.value === 'other' && !document.getElementById('other-reason-text').value.trim()) { alert('Please specify your reason.'); return; }

            const reqId = 'RET-' + Math.floor(Math.random()*90000+10000);
            document.getElementById('request-id').textContent = reqId;
            document.getElementById('confirmation-text').textContent = returnType === 'return'
                ? `Your return request for order ${foundOrder.id} has been submitted successfully.`
                : `Your exchange request for order ${foundOrder.id} has been submitted successfully.`;

            // Store the return request
            const returns = JSON.parse(localStorage.getItem('aura_returns') || '[]');
            returns.push({
                id: reqId, orderId: foundOrder.id, type: returnType,
                reason: selected.value === 'other' ? 'Other: ' + document.getElementById('other-reason-text').value : selected.value,
                comments: document.getElementById('return-comments').value,
                date: new Date().toISOString(), status: 'Pending'
            });
            localStorage.setItem('aura_returns', JSON.stringify(returns));
            goTo(4);
        });

        // New request
        document.getElementById('btn-new-request').addEventListener('click', () => {
            document.getElementById('return-order-id').value = '';
            document.getElementById('return-email').value = '';
            document.querySelectorAll('input[name="return-reason"]').forEach(r => r.checked = false);
            document.getElementById('other-reason-text').value = '';
            document.getElementById('return-comments').value = '';
            document.getElementById('other-reason-group').style.display = 'none';
            foundOrder = null; goTo(1);
        });
    });
    </script>