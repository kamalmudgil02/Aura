<style>
    .about-hero { height: 50vh; min-height: 350px; background: linear-gradient(rgba(0,0,0,.35),rgba(0,0,0,.55)), url('https://images.unsplash.com/photo-1441986300917-64674bd600d8?ixlib=rb-4.0.3&auto=format&fit=crop&w=1600&q=80') center/cover no-repeat; color: #fff; display: flex; align-items: center; justify-content: center; text-align: center; }
    .about-section { padding: var(--space-8) 0; }
    .about-section:nth-child(even) { background: var(--color-bg-alt); }
    .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-6); align-items: center; }
    .about-img { width: 100%; height: 350px; object-fit: cover; border-radius: var(--radius-md); }
    .values-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); margin-top: var(--space-4); }
    .value-card { text-align: center; padding: var(--space-4); border: 1px solid var(--color-border); border-radius: var(--radius-md); }
    .value-icon { font-size: 2.5rem; margin-bottom: var(--space-2); }
    .team-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); margin-top: var(--space-4); }
    .team-card { text-align: center; }
    .team-avatar { width: 120px; height: 120px; border-radius: 50%; object-fit: cover; margin: 0 auto var(--space-2); display: block; background: var(--color-bg-alt); }
    @media (max-width: 768px) { .about-grid, .values-grid, .team-grid { grid-template-columns: 1fr; } }
</style>

<section class="about-hero">
    <div class="container">
        <h1 class="text-4xl mb-3">Our Story</h1>
        <p class="text-lg" style="max-width:550px;margin:0 auto;opacity:.9;">We're building the future of everyday essentials — better materials, radical transparency, zero compromise.</p>
    </div>
</section>

<section class="about-section">
    <div class="container about-grid">
        <div>
            <h2 class="text-2xl mb-3">Why We Started</h2>
            <p class="text-muted mb-3">Aura was born in 2024 from a simple frustration: everyday clothing forces you to choose between comfort, durability, and sustainability. We refused to accept that trade-off.</p>
            <p class="text-muted mb-3">After two years of research and development, we created a proprietary fabric blend made from responsibly sourced eucalyptus tree fibers and organic Pima cotton — highly breathable, odor-resistant, and luxuriously soft.</p>
            <p class="text-muted">Today, Aura serves thousands of customers who believe that what you wear every day should be exceptional — without costing the earth.</p>
        </div>
        <img src="https://images.unsplash.com/photo-1544441893-675973e31985?w=800&q=80" alt="Our workshop" class="about-img">
    </div>
</section>

<section class="about-section">
    <div class="container text-center">
        <h2 class="text-2xl mb-2">Our Values</h2>
        <p class="text-muted mb-4">These principles guide every decision we make.</p>
        <div class="values-grid">
            <div class="value-card"><div class="value-icon">🌿</div><h3 class="fw-semibold mb-1">Sustainability First</h3><p class="text-sm text-muted">Every material is ethically sourced. Zero-waste packaging. Carbon-neutral shipping.</p></div>
            <div class="value-card"><div class="value-icon">🔍</div><h3 class="fw-semibold mb-1">Radical Transparency</h3><p class="text-sm text-muted">We share our costs, margins, and factory details. No hidden markups.</p></div>
            <div class="value-card"><div class="value-icon">✨</div><h3 class="fw-semibold mb-1">Premium Quality</h3><p class="text-sm text-muted">Each piece is designed to last years, not seasons. Quality over quantity.</p></div>
            <div class="value-card"><div class="value-icon">🤝</div><h3 class="fw-semibold mb-1">Fair Labor</h3><p class="text-sm text-muted">Living wages, safe conditions, and dignity for every person in our supply chain.</p></div>
            <div class="value-card"><div class="value-icon">♻️</div><h3 class="fw-semibold mb-1">Circular Design</h3><p class="text-sm text-muted">Products designed for longevity with a take-back program for recycling.</p></div>
            <div class="value-card"><div class="value-icon">💚</div><h3 class="fw-semibold mb-1">Community</h3><p class="text-sm text-muted">1% of every sale supports environmental nonprofits worldwide.</p></div>
        </div>
    </div>
</section>

<section class="about-section">
    <div class="container text-center">
        <h2 class="text-2xl mb-2">Meet The Team</h2>
        <p class="text-muted mb-4">The people behind Aura.</p>
        <div class="team-grid">
            <div class="team-card"><img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=300&q=80" alt="Alex" class="team-avatar"><h4 class="fw-semibold">Alex Rivera</h4><p class="text-sm text-muted">Founder & CEO</p></div>
            <div class="team-card"><img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=300&q=80" alt="Maya" class="team-avatar"><h4 class="fw-semibold">Maya Chen</h4><p class="text-sm text-muted">Creative Director</p></div>
            <div class="team-card"><img src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=300&q=80" alt="Jordan" class="team-avatar"><h4 class="fw-semibold">Jordan Okafor</h4><p class="text-sm text-muted">Head of Sustainability</p></div>
        </div>
    </div>
</section>

<section class="about-section text-center" style="background:var(--color-primary);color:#fff;padding:var(--space-8) 0;">
    <div class="container">
        <h2 class="text-2xl mb-3">Join the Movement</h2>
        <p style="max-width:500px;margin:0 auto var(--space-4);opacity:.85;">Better basics for a better world. Shop Aura and feel the difference.</p>
        <a href="/" class="btn btn-large" style="background:#fff;color:var(--color-primary);">Shop Now</a>
    </div>
</section>

{% schema %}
