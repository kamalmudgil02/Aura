<main style="padding: var(--space-6) 0; min-height: 60vh;">
    <div class="container">
        <div class="text-center mb-6">
            <h1 class="text-3xl text-uppercase mb-2" id="collection-title">Collection</h1>
            <p class="text-muted" id="collection-desc">Explore our curated selection.</p>
        </div>
        <div class="flex justify-between align-center mb-4 text-sm border-bottom" style="padding-bottom:var(--space-2);">
            <span id="product-count" class="text-muted">0 products</span>
            <div class="flex gap-2 align-center">
                <span>Sort by:</span>
                <select class="form-control" id="sort-select" style="width:auto; padding:8px 12px;"><option value="featured">Featured</option><option value="price-low">Price: Low → High</option><option value="price-high">Price: High → Low</option></select>
            </div>
        </div>
        <div class="grid grid-cols-2 md-grid-cols-4 gap-3" id="collection-grid"><div class="text-muted col-span-full text-center p-4">Loading...</div></div>
    </div>
</main>

<script>
(function() {
    const grid = document.getElementById('collection-grid');
    if (!grid || !window.Store) return;
    const hash = window.location.hash.replace('#', '').toLowerCase().trim();
    const param = new URLSearchParams(window.location.search).get('category');
    const category = hash || param || 'all';
    const names = { men: "Men's Collection", women: "Women's Collection", footwear: "Footwear", accessories: "Accessories", all: "All Products" };
    const titleEl = document.getElementById('collection-title');
    if (titleEl) titleEl.textContent = names[category] || category.charAt(0).toUpperCase() + category.slice(1);
    document.title = (names[category] || 'Collection') + ' — Aura';
    let products = category === 'all' ? window.Store.getProducts() : window.Store.getProductsByCategory(category);
    const countEl = document.getElementById('product-count');
    if (countEl) countEl.textContent = products.length + ' product' + (products.length !== 1 ? 's' : '');
    function getImg(p) { if (p.variants && p.variants.length && p.variants[0].images && p.variants[0].images.length) return p.variants[0].images[0]; return p.image || 'https://via.placeholder.com/400x500?text=No+Image'; }
    function cardHTML(p) {
        const img = getImg(p);
        const badges = [];
        if (p.isNew) badges.push('<span class="badge-new">New</span>');
        if (p.isBestSeller) badges.push('<span class="badge-best">Best Seller</span>');
        return `<div class="product-card"><a href="/pages/product#${p.id}" class="product-img-link"><div class="product-img-container"><img src="${img}" alt="${p.title}" loading="lazy">${badges.join('')}</div></a><div class="product-info"><h3 class="product-title">${p.title}</h3><p class="product-price">$${p.price.toFixed(2)}</p><p class="product-sizes text-xs text-muted">Sizes: ${(p.sizes||[]).join(', ')}</p></div><button class="btn btn-outline w-full btn-quick-add" data-id="${p.id}">Quick Add</button></div>`;
    }
    function renderGrid(prods) { grid.innerHTML = prods.length ? prods.map(cardHTML).join('') : '<div class="text-muted col-span-full p-4 text-center">No products found in this category.</div>'; }
    renderGrid(products);
    const sortSelect = document.getElementById('sort-select');
    if (sortSelect) { sortSelect.addEventListener('change', function() { let s = [...products]; if (this.value === 'price-low') s.sort((a, b) => a.price - b.price); else if (this.value === 'price-high') s.sort((a, b) => b.price - a.price); renderGrid(s); }); }
})();
</script>

{% schema %}
{"name": "collection", "settings": []}
{% endschema %}