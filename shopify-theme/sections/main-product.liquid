<main class="container" style="padding-top: var(--space-4); padding-bottom: var(--space-8);">
    <nav class="text-sm text-muted mb-4" style="display:flex; gap:6px; align-items:center;">
        <a href="/" class="link">Home</a> <span>/</span>
        <a href="/pages/collection" class="link" id="pdp-category-link">Shop</a> <span>/</span>
        <span class="fw-medium text-primary" id="pdp-breadcrumb-title">Loading...</span>
    </nav>

    <div class="grid grid-cols-1 md-grid-cols-2 gap-6" id="pdp-content-container">
        <!-- Left: Gallery -->
        <div class="product-gallery">
            <div class="main-image-container">
                <img id="main-product-image" src="" alt="Product" style="width:100%; height:100%; object-fit:cover; position:absolute; top:0; left:0;">
            </div>
            <div class="thumb-grid" id="pdp-thumb-grid"></div>
        </div>

        <!-- Right: Info -->
        <div class="product-info-panel-wrapper">
            <div class="product-info-panel">
                <h1 class="text-3xl mb-1" id="pdp-title">Loading...</h1>
                <p class="text-xl fw-semibold mb-2" id="pdp-price">$0.00</p>
                <div class="flex align-center gap-2 mb-4">
                    <span id="pdp-star-avg" style="color:#f5a623; font-size: var(--font-size-sm);">★★★★★</span>
                    <a href="#customer-reviews" class="text-sm text-muted link" id="pdp-review-count">(0 Reviews)</a>
                </div>
                <p class="text-base text-muted mb-6" id="pdp-desc">Loading...</p>

                <div class="mb-4">
                    <span class="text-sm fw-medium">Color: <span class="fw-regular text-muted" id="selected-color-name">—</span></span>
                    <div class="flex gap-2 mt-2" id="pdp-color-swatches"></div>
                </div>
                <div class="mb-6">
                    <div class="flex justify-between mb-2">
                        <span class="text-sm fw-medium">Size</span>
                        <a href="#" class="text-sm text-muted link" onclick="alert('Size Guide: Use standard US sizing.'); return false;">Size Guide</a>
                    </div>
                    <div class="grid grid-cols-4 gap-2" id="pdp-sizes-container"></div>
                </div>

                <div id="pdp-trust-badges" class="mb-4"></div>
                <div id="pdp-sku" class="mb-3"></div>
                <button class="btn btn-primary w-full btn-large mb-4" id="pdp-add-to-cart-btn">Add to Cart</button>
                <p class="text-xs text-center text-muted mb-6">Free shipping and 30-day free returns.</p>

                <div class="accordion border-top">
                    <div class="accordion-item active">
                        <button class="accordion-header">Product Details
                            <svg class="accordion-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor"><path d="M5 7l5 5 5-5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </button>
                        <div class="accordion-content"><div class="accordion-content-inner">
                            <ul style="list-style:disc; margin-left:20px;"><li>Premium sustainable materials</li><li>Tailored but relaxed fit</li><li>Reinforced stitching</li><li>Tagless interior</li></ul>
                        </div></div>
                    </div>
                    <div class="accordion-item">
                        <button class="accordion-header">Shipping & Returns
                            <svg class="accordion-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor"><path d="M5 7l5 5 5-5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </button>
                        <div class="accordion-content"><div class="accordion-content-inner"><p>Free standard shipping on orders $150+. 30-day free returns on unworn items.</p></div></div>
                    </div>
                </div>

                <div id="customer-reviews" class="mt-8 pt-6 border-top">
                    <h2 class="text-xl mb-4">Customer Reviews</h2>
                    <div id="reviews-list" class="mb-6"></div>
                    <div class="review-form-container">
                        <h3>Write a Review</h3>
                        <form id="review-form">
                            <div class="grid grid-cols-1 md-grid-cols-2 gap-3">
                                <div class="form-group"><label class="form-label">Your Name</label><input type="text" id="review-name" class="form-control" required placeholder="Jane Smith"></div>
                                <div class="form-group"><label class="form-label">Rating</label><select id="review-rating" class="form-control" required><option value="5">★★★★★</option><option value="4">★★★★☆</option><option value="3">★★★☆☆</option><option value="2">★★☆☆☆</option><option value="1">★☆☆☆☆</option></select></div>
                            </div>
                            <div class="form-group"><label class="form-label">Your Review</label><textarea id="review-comment" class="form-control" rows="3" required placeholder="Tell us what you think..."></textarea></div>
                            <button type="submit" class="btn btn-primary">Submit Review</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
<div class="mobile-sticky-cta" id="sticky-cta"><button class="btn btn-primary w-full btn-large" id="pdp-sticky-add-btn">Add to Cart</button></div>

{% schema %}
{"name": "product", "settings": []}
{% endschema %}